# SmartyP Environment Configuration

# Required
MUSIC_ROOT=/path/to/your/music

# Server port (default: 8080)
PORT=8080

# Navidrome connection (required for direct deployment and rescan)
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=admin
NAVIDROME_PASS=password

# Playlist directory (optional, defaults to MUSIC_ROOT/playlists/)
# This is where .nsp files are written when deploying
# PLAYLIST_PATH=/path/to/navidrome/playlists

# CORS (only needed for dev mode when running frontend separately)
# Not needed when using the built binary — frontend is embedded same-origin.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
