# SmartyP Environment Configuration

# Backend (Go) Configuration
MUSIC_ROOT=/path/to/your/music
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=admin
NAVIDROME_PASS=password

# CORS allowed origins (comma-separated)
# Defaults to http://localhost:3000,http://localhost:5173 if not set
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (Vite) Configuration
# Create a .env file with these values for the frontend
VITE_API_BASE=http://localhost:8080/api
